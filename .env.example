# ChatStudio configuration

# --- Auth / sessions ---
# Generate a unique secret: python -c "import secrets; print(secrets.token_hex(32))"
# Required on Render; production startup rejects empty, weak or default values.
SESSION_SECRET=
# HTTPS production default. Set to 0 only for local plain-HTTP development.
SESSION_COOKIE_SECURE=1
SESSION_MAX_AGE=604800
CSRF_PROTECTION=1

# --- Paths (inside container) ---
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads
FRONTEND_DIR=/app/frontend

# --- AI ---
GLOBAL_AI_CONCURRENCY=2
REQUEST_TIMEOUT=300

# --- Web search ---
WEB_SEARCH_ENABLED=1
WEB_SEARCH_TIMEOUT=8
# Optional private/local SearXNG URL. If omitted, public search fallbacks are tried.
# SEARXNG_URL=http://searxng-web:8080

# --- Sandbox ---
# Server-side execution is enabled by default through the isolated runner.
# On ZimaOS, connect the ai-ch app container to the runner's internal Docker network.
# SANDBOX_URL=http://chatstudio-sandbox:8000
# For an external runner, set SANDBOX_URL and (if required) the matching SANDBOX_API_KEY.
SANDBOX_ALLOW_LOCAL=0
SANDBOX_WORK_DIR=/app/data/sandbox

# --- Text-to-speech ---
# OpenAI-compatible API base URL; backend calls {TTS_BASE_URL}/audio/speech.
# Set the provider URL, secret key, model and voice in Render Environment.
# TTS_BASE_URL=https://your-tts-provider.example/v1
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_RESPONSE_FORMAT=mp3
TTS_TIMEOUT=180
TTS_MAX_CHARS=30000
TTS_CONCURRENCY=2
# Separate explicit OpenAI-compatible chat-completions model; no auto-selection.
# It rewrites math, LaTeX, code-like notation, science symbols and units into spoken Russian.
TTS_PREPROCESS_BASE_URL=
TTS_PREPROCESS_API_KEY=
TTS_PREPROCESS_MODEL=
TTS_PREPROCESS_TIMEOUT=180
TTS_PREPROCESS_MAX_TOKENS=12000
TTS_PREPROCESS_TEMPERATURE=0.1

# --- Files limits ---
MAX_FILE_SIZE=26214400
MAX_TOTAL_FILE_SIZE=104857600
MAX_FILES_PER_REQUEST=10

# --- Primary model ---
# The primary MAIN model is configured in AI CH → Admin → Model Sets.
# Leave legacy QWEN_* environment overrides unset on Render so the active MAIN
# model entry controls its provider, API key, base URL and model ID.

# --- Optional automatic fast Qwen response lane ---
# All three values are required. The primary MAIN model continues to use its
# active Model Sets entry; FAST_QWEN_* are only for the parallel short-answer model.
FAST_QWEN_BASE_URL=
FAST_QWEN_API_KEY=
FAST_QWEN_MODEL_ID=
# Hard-capped in code at 8000 output tokens, even if this setting is edited.
FAST_QWEN_MAX_TOKENS=8000
FAST_QWEN_TIMEOUT=60
# Default to zero for a free endpoint; set real prices if this API bills usage.
FAST_QWEN_PRICE_IN=0
FAST_QWEN_PRICE_OUT=0
FAST_QWEN_PRICE_CACHE=0

# --- Code Agent ---
# At most three model turns are permitted for Code Agent even if a higher value is supplied.
CODE_AGENT_MAX_STEPS=3

# --- Admin bootstrap (optional) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Pro users bootstrap (optional) ---
# JSON array; new accounts are created at startup, existing accounts are granted Pro.
# Existing accounts keep their current password, name and admin role.
# PRO_USERS_JSON=[{"email":"user1@example.com","password":"replace-with-strong-password","name":"User One"},{"email":"user2@example.com","password":"replace-with-another-strong-password","name":"User Two"}]
