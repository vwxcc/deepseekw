# ChatStudio configuration

# --- Auth / sessions ---
# Generate a unique secret: python -c "import secrets; print(secrets.token_hex(32))"
# Required on Render; production startup rejects empty, weak or default values.
SESSION_SECRET=
# HTTPS production default. Set to 0 only for local plain-HTTP development.
SESSION_COOKIE_SECURE=1
SESSION_MAX_AGE=604800
CSRF_PROTECTION=1

# --- Paths (inside container) ---
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads
FRONTEND_DIR=/app/frontend

# --- AI ---
GLOBAL_AI_CONCURRENCY=2
REQUEST_TIMEOUT=300

# --- Web search ---
WEB_SEARCH_ENABLED=1
WEB_SEARCH_TIMEOUT=8
# Optional private/local SearXNG URL. If omitted, public search fallbacks are tried.
# SEARXNG_URL=http://searxng-web:8080

# --- Sandbox ---
# 0 (recommended for the current rollout): do not execute code in an agent loop.
# The model returns one complete answer; marked file-creation code is attempted on-device afterwards.
# 1: attempt the isolated server runner only after the complete model answer; fall back to device if unavailable.
RUN_SANDBOX_ENABLED=0
# Keep the sandbox in a separate runner service for public/Render deployments.
# Set SANDBOX_URL to the runner's actual URL and SANDBOX_API_KEY to the same
# long random secret on BOTH the app and runner services.
# SANDBOX_URL=https://your-sandbox-service.onrender.com
# SANDBOX_API_KEY=
SANDBOX_ALLOW_LOCAL=0
SANDBOX_WORK_DIR=/app/data/sandbox

# --- Text-to-speech ---
# OpenAI-compatible API base URL; backend calls {TTS_BASE_URL}/audio/speech.
# Set the provider URL, secret key, model and voice in Render Environment.
# TTS_BASE_URL=https://your-tts-provider.example/v1
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_RESPONSE_FORMAT=mp3
TTS_TIMEOUT=180
TTS_MAX_CHARS=30000
TTS_CONCURRENCY=2
# Separate explicit OpenAI-compatible chat-completions model; no auto-selection.
# It rewrites math, LaTeX, code-like notation, science symbols and units into spoken Russian.
TTS_PREPROCESS_BASE_URL=
TTS_PREPROCESS_API_KEY=
TTS_PREPROCESS_MODEL=
TTS_PREPROCESS_TIMEOUT=180
TTS_PREPROCESS_MAX_TOKENS=12000
TTS_PREPROCESS_TEMPERATURE=0.1

# --- Files limits ---
MAX_FILE_SIZE=26214400
MAX_TOTAL_FILE_SIZE=104857600
MAX_FILES_PER_REQUEST=10

# --- Primary MAIN model provider ---
# Explicit non-empty QWEN_* values override fields on the active MAIN entry at runtime.
# Provider type is metadata; requests use the OpenAI-compatible chat-completions protocol.
QWEN_PROVIDER=openai
QWEN_API_KEY=
# Base URL for the provider, usually ending in /v1.
QWEN_BASE_URL=https://llm.stage.satel.org/v1
# Explicit external model ID (wins over QWEN_MODEL when non-empty).
QWEN_MODEL_ID=
# Backward-compatible model name / initial seed; still honored if QWEN_MODEL_ID is empty.
QWEN_MODEL=qwen36-35b
QWEN_TEMPERATURE=0.2
QWEN_MAX_TOKENS=32000
# Optional overrides in USD per 1,000,000 tokens; leave commented to use
# the per-model prices configured in the admin Model Sets screen.
# QWEN_PRICE_IN=2
# QWEN_PRICE_OUT=25
# QWEN_PRICE_CACHE=0.02

# --- Code Agent ---
# At most three model turns are permitted for Code Agent even if a higher value is supplied.
CODE_AGENT_MAX_STEPS=3

# --- Admin bootstrap (optional) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
